{
  "name": "@iqkv/foundation-ui-platform-admin",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b && pnpm messages:extract && pnpm messages:compile && vite build",
    "ci": "pnpm ci:lint && pnpm ci:test",
    "ci:lint": "pnpm lint",
    "ci:test": "pnpm test",
    "cleanup": "rimraf dist .tanstack coverage .stylelintcache",
    "cleanup:all": "pnpm cleanup && pnpm node_modules:cleanup",
    "dev": "vite",
    "e2e": "playwright test",
    "e2e:a11y": "playwright test pages/admin/accessibility --project=chromium",
    "e2e:all-browsers": "cross-env ALL_BROWSERS=true playwright test",
    "e2e:auth": "playwright test features/sign-in features/sign-out --project=chromium",
    "e2e:chrome": "playwright test --project=chromium",
    "e2e:debug": "cross-env PWDEBUG=1 playwright test",
    "e2e:firefox": "playwright test --project=firefox",
    "e2e:headed": "playwright test --headed",
    "e2e:pages": "playwright test pages/admin --project=chromium",
    "e2e:remote": "cross-env BASE_URL=https://admin.iqkv.site playwright test --project=chromium",
    "e2e:remote:ui": "cross-env BASE_URL=https://admin.iqkv.site playwright test --ui --project=chromium",
    "e2e:report": "playwright show-report",
    "e2e:smoke": "playwright test smoke --project=chromium",
    "e2e:ui": "playwright test --ui",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:webkit": "playwright test --project=webkit",
    "formatter:check": "oxfmt --check",
    "formatter:write": "oxfmt --write",
    "knip": "knip",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix && pnpm formatter:write",
    "lint:stylelint": "stylelint \"**/*.css\" --aei",
    "messages:compile": "lingui compile",
    "messages:extract": "lingui extract",
    "node_modules:cleanup": "rm -rf node_modules",
    "playwright:install": "playwright install --with-deps",
    "prepare": "husky",
    "preview": "vite preview",
    "release": "release-it --ci",
    "test": "vitest run",
    "test:arch": "vitest run architecture",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest run --ui",
    "test:wath": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@dr.pogodin/react-helmet": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@lingui/core": "^6.4.0",
    "@lingui/format-po": "^6.4.0",
    "@lingui/react": "^6.4.0",
    "@mantine/carousel": "^9.4.0",
    "@mantine/charts": "^9.4.0",
    "@mantine/core": "^9.4.0",
    "@mantine/dates": "^9.4.0",
    "@mantine/dropzone": "^9.4.0",
    "@mantine/form": "^9.4.1",
    "@mantine/hooks": "^9.4.0",
    "@mantine/modals": "^9.4.0",
    "@mantine/notifications": "^9.4.1",
    "@mantine/nprogress": "^9.4.0",
    "@mantine/tiptap": "^9.4.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@stomp/stompjs": "^7.3.0",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.16",
    "@tiptap/extension-color": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@types/sanitize-html": "^2.16.1",
    "@xyflow/react": "^12.11.1",
    "axios": "^1.18.1",
    "chroma-js": "^3.2.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "collect.js": "^4.36.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "immer": "^11.1.8",
    "js-cookie": "^3.0.8",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "lottie-web": "^5.13.0",
    "mantine-datatable": "^9.3.1",
    "miragejs": "^0.1.48",
    "nuqs": "^2.8.9",
    "query-string": "^9.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "react-infinite-scroll-component": "^7.2.1",
    "react-lottie": "^1.2.10",
    "sanitize-html": "^2.17.5",
    "sockjs-client": "^1.6.1",
    "ts-pattern": "^5.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@lingui/cli": "^6.4.0",
    "@lingui/swc-plugin": "^6.5.0",
    "@lingui/vite-plugin": "^6.4.0",
    "@playwright/test": "1.61.0",
    "@release-it/conventional-changelog": "^11.0.1",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sockjs-client": "^1.5.4",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/coverage-v8": "4.1.5",
    "@vitest/ui": "4.1.5",
    "autoprefixer": "^10.5.2",
    "cz-conventional-changelog": "^3.3.0",
    "gitzy": "7.2.2",
    "globals": "^17.7.0",
    "happy-dom": "20.10.6",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "is-ci": "4.1.0",
    "jiti": "2.7.0",
    "jsdom": "^29.1.1",
    "knip": "6.23.0",
    "lint-staged": "^17.0.8",
    "lru-cache": "^11.5.1",
    "msw": "^2.14.6",
    "nx": "^23.0.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^0.23.0",
    "postcss": "^8.5.15",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prop-types": "^15.8.1",
    "release-it": "^19.2.4",
    "release-it-pnpm": "^4.6.6",
    "sort-package-json": "^4.0.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsdown": "^0.22.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.0",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-copy": "^0.1.6",
    "vite-plugin-remove-console": "^2.2.0",
    "vitest": "4.1.5"
  },
  "lint-staged": {
    "*": [
      "pnpm formatter:check"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@10.33.2",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
