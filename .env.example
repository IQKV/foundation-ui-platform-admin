# API Configuration
VITE_API_SERVER_URL=https://api.iqkv.site/api

# Log level: 'silent', 'info', 'debug'
VITE_LOG_LEVEL=info

# ─── Platform Mode ────────────────────────────────────────────────────────────
# Platform-wide operational mode: 'MULTI_TENANT' (default) or 'SINGLE_TENANT'
VITE_ROLLOUT_MODE=MULTI_TENANT

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Demo mode: 'true' or 'false' (default)
VITE_DEMO_MODE=false

# Comma-separated list of enabled addon IDs
VITE_ENABLED_UI_ADDONS=

# Navigation layout variant: 'topbar' (horizontal toolbar) or 'sidebar' (default)
# VITE_APP_NAV_VARIANT=sidebar

# ═══════════════════════════════════════════════════════════════════════════════
#  WHITELABELING / BRANDING
#  Set VITE_APP_TITLE and you are done — everything else derives from it.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Core Branding (only this one is truly required) ─────────────────────────
# Application name; used as document title suffix everywhere.
# If nothing else below is set, all brand strings derive from this.
VITE_APP_TITLE=Key Value

# ─── Secondary Branding (all optional — fall back to VITE_APP_TITLE) ──────────
# Displayed in the sidebar/topbar logo area. Defaults to VITE_APP_TITLE.
# VITE_APP_BRAND_NAME=Key Value

# Small uppercase tagline below the brand name in the sidebar.
# VITE_APP_BRAND_TAGLINE=Platform Admin

# ─── Footer / Legal / Support ─────────────────────────────────────────────────
# Copyright line. Defaults to "© {currentYear} {VITE_APP_BRAND_NAME}. All rights reserved."
# VITE_APP_FOOTER_COPYRIGHT=© 2026 Key Value. All rights reserved.

# Support email. If set, shown in auth footer (when no VITE_APP_SUPPORT_URL).
# VITE_APP_SUPPORT_EMAIL=support@example.com

# Support / Help Center URL. If set, shown as "Support" link in auth footer.
# VITE_APP_SUPPORT_URL=https://support.example.com

# Privacy policy URL — adds "Privacy" link in auth footer.
# VITE_APP_PRIVACY_URL=https://example.com/privacy

# Terms of service URL — adds "Terms" link in auth footer.
# VITE_APP_TERMS_URL=https://example.com/terms
