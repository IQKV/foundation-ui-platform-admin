# ─── E2E test environment ─────────────────────────────────────────────────────
# Targets the publicly available staging deployment.
# Override BASE_URL on the command line to point at a different host:
#   BASE_URL=http://localhost:5173 pnpm e2e

BASE_URL=https://admin.iqkv.site
VITE_API_SERVER_URL=https://api.iqkv.site/api

# ─── Platform admin credentials ───────────────────────────────────────────────
# The admin UI only accepts users with PLATFORM_ADMIN authority.
# Tenant-scoped users (TENANT_OWNER, ADMIN, MEMBER) cannot sign in here.
# Authenticates via POST /v1/iam/auth/admin/signin (no X-Tenant-ID header).
#
# Seeded by migration 20260517000004-demo-e2e-users.xml.
# Credentials are intentionally committed — demo/staging database only.

E2E_PLATFORM_ADMIN_EMAIL=jonathan.pierce@iqkv.com
E2E_PLATFORM_ADMIN_PASSWORD=ChangeMePass123!
